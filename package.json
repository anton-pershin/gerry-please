{
  "name": "gerry-please",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "File-configured, runtime-neutral multi-agent automation for GitHub webhooks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anton-pershin/gerry-please.git"
  },
  "bin": {
    "gerry": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts serve",
    "start": "bun run src/cli.ts serve",
    "validate": "bun run src/cli.ts validate",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@octokit/app": "^16.1.0",
    "@opencode/client": "latest",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
